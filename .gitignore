# --- 1. Artefatos de Build do Frontend (CRÍTICO) ---
dist/
dist_painel/
dist_pwa/
build/
.vite/
*.tsbuildinfo
**/.vitest-cache/

# --- 2. Segredos e Ambientes (SEGURANÇA MÁXIMA) ---
.env
.env.*
!.env.test
!.env.example
keys/
*.pem
*.key
*.p12
*service-account*.json
firebase-credenciais.json

# --- 3. Dependências ---
# Python
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.mypy_cache/**
**/.hypothesis/**

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*
.yarn/

# --- 4. Terraform (Estado e Plugins) ---
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
# Cloud Functions build artifacts (zips and prepared source)
terraform/infra/files/

# --- 5. IDEs e Editores ---
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- 6. Logs e Testes ---
*.log
coverage/
htmlcov/
.coverage*
.pytest_cache/
reports/
.benchmarks/
firestore-debug.log
firebase-debug.log

# --- 7. Firebase e Emuladores ---
.firebase/
emulator-data/
firebase-export*/

